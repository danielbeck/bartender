{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The invented drink's name."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "The drink's flavors and how it matches the search preferences."
    },
    "mixingInstructions": {
      "type": "string",
      "minLength": 1,
      "description": "Concise, practical instructions for preparing the drink."
    },
    "glass": {
      "type": "string",
      "enum": ["coupe", "flute", "highball", "hurricane", "irish-coffee", "julep", "martini", "mug", "rocks", "tall", "wine"],
      "description": "The serving glass used for the drink illustration."
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "A specific ingredient name."
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "The ingredient's approximate color as a six-digit hex color."
          },
          "quantity": {
            "type": "string",
            "minLength": 1,
            "description": "Liquid volumes must use a positive number followed by ' ml', e.g. '45 ml'. Other measures may use '2 dashes' or '1 lime wedge'."
          }
        },
        "required": ["name", "quantity", "color"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "description", "mixingInstructions", "glass", "ingredients"],
  "additionalProperties": false
}
